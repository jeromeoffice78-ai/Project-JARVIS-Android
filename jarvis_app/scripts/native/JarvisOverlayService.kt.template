package __PACKAGE__

import android.animation.ValueAnimator
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.Intent
import android.content.pm.ServiceInfo
import android.graphics.Color
import android.graphics.PixelFormat
import android.os.Build
import android.os.Handler
import android.os.IBinder
import android.os.Looper
import android.provider.Settings
import android.view.Gravity
import android.view.View
import android.view.WindowManager
import android.view.animation.AccelerateDecelerateInterpolator
import android.webkit.WebView
import android.webkit.WebViewClient
import kotlin.math.roundToInt

class JarvisOverlayService : Service() {
    companion object {
        const val ACTION_START =
            "jarvis.overlay.START"
        const val ACTION_STOP =
            "jarvis.overlay.STOP"
        const val EXTRA_STATE_JSON =
            "jarvis.overlay.STATE_JSON"

        private const val CHANNEL_ID =
            "jarvis_overlay_presence"
        private const val NOTIFICATION_ID =
            4207

        @Volatile
        var instance: JarvisOverlayService? = null
            private set

        @Volatile
        var isRunning: Boolean = false
            private set
    }

    private lateinit var windowManager: WindowManager
    private var avatarView: WebView? = null
    private var layoutParams:
        WindowManager.LayoutParams? = null
    private var movementAnimator:
        ValueAnimator? = null

    private val handler =
        Handler(Looper.getMainLooper())

    private var targetIndex = 0
    private var pageReady = false
    private var lastStateJson =
        """{"active":true,"activity":"idle","mood":"confident","connected":false,"companion":false,"transcript":"","audioLevel":0,"audioLevelAvailable":false}"""

    private val wanderRunnable =
        object : Runnable {
            override fun run() {
                moveToNextPosition()
                handler.postDelayed(
                    this,
                    6500L,
                )
            }
        }

    override fun onCreate() {
        super.onCreate()
        instance = this
        windowManager =
            getSystemService(WINDOW_SERVICE)
                as WindowManager
    }

    override fun onStartCommand(
        intent: Intent?,
        flags: Int,
        startId: Int,
    ): Int {
        if (intent?.action == ACTION_STOP) {
            stopSelf()
            return START_NOT_STICKY
        }

        if (!Settings.canDrawOverlays(this)) {
            stopSelf()
            return START_NOT_STICKY
        }

        intent
            ?.getStringExtra(EXTRA_STATE_JSON)
            ?.takeIf { it.isNotBlank() }
            ?.let {
                lastStateJson = it
            }

        startAsForeground()
        ensureOverlay()
        isRunning = true

        return START_STICKY
    }

    override fun onBind(intent: Intent?): IBinder? =
        null

    override fun onDestroy() {
        isRunning = false
        instance = null

        handler.removeCallbacksAndMessages(null)
        movementAnimator?.cancel()
        movementAnimator = null

        val view = avatarView
        avatarView = null

        if (view != null) {
            try {
                windowManager.removeView(view)
            } catch (_: Throwable) {
                // The overlay may already be detached.
            }

            view.stopLoading()
            view.loadUrl("about:blank")
            view.destroy()
        }

        stopForeground(STOP_FOREGROUND_REMOVE)
        super.onDestroy()
    }

    fun updateAvatarState(
        stateJson: String,
    ) {
        lastStateJson = stateJson
        applyLatestState()
    }

    private fun startAsForeground() {
        val notificationManager =
            getSystemService(NOTIFICATION_SERVICE)
                as NotificationManager

        val channel = NotificationChannel(
            CHANNEL_ID,
            "JARVIS floating presence",
            NotificationManager.IMPORTANCE_LOW,
        ).apply {
            description =
                "Keeps the user-enabled JARVIS avatar visible over other apps."
            setShowBadge(false)
        }

        notificationManager.createNotificationChannel(
            channel,
        )

        val openIntent =
            packageManager
                .getLaunchIntentForPackage(packageName)
                ?.addFlags(
                    Intent.FLAG_ACTIVITY_SINGLE_TOP,
                )

        val openPendingIntent =
            PendingIntent.getActivity(
                this,
                0,
                openIntent,
                PendingIntent.FLAG_UPDATE_CURRENT or
                    PendingIntent.FLAG_IMMUTABLE,
            )

        val stopIntent = Intent(
            this,
            JarvisOverlayService::class.java,
        ).setAction(ACTION_STOP)

        val stopPendingIntent =
            PendingIntent.getService(
                this,
                1,
                stopIntent,
                PendingIntent.FLAG_UPDATE_CURRENT or
                    PendingIntent.FLAG_IMMUTABLE,
            )

        val notification =
            Notification.Builder(
                this,
                CHANNEL_ID,
            )
                .setSmallIcon(
                    android.R.drawable.presence_online,
                )
                .setContentTitle(
                    "JARVIS is on screen",
                )
                .setContentText(
                    "Floating avatar is active. Tap Hide to remove it.",
                )
                .setOngoing(true)
                .setCategory(
                    Notification.CATEGORY_SERVICE,
                )
                .setContentIntent(
                    openPendingIntent,
                )
                .addAction(
                    Notification.Action.Builder(
                        null,
                        "Hide",
                        stopPendingIntent,
                    ).build(),
                )
                .build()

        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.UPSIDE_DOWN_CAKE
        ) {
            startForeground(
                NOTIFICATION_ID,
                notification,
                ServiceInfo
                    .FOREGROUND_SERVICE_TYPE_SPECIAL_USE,
            )
        } else {
            startForeground(
                NOTIFICATION_ID,
                notification,
            )
        }
    }

    @Suppress("SetJavaScriptEnabled")
    private fun ensureOverlay() {
        if (avatarView != null) {
            applyLatestState()
            return
        }

        val width = dp(220)
        val height = dp(380)

        val params =
            WindowManager.LayoutParams(
                width,
                height,
                WindowManager.LayoutParams
                    .TYPE_APPLICATION_OVERLAY,
                WindowManager.LayoutParams
                    .FLAG_NOT_FOCUSABLE or
                    WindowManager.LayoutParams
                        .FLAG_NOT_TOUCHABLE or
                    WindowManager.LayoutParams
                        .FLAG_LAYOUT_IN_SCREEN,
                PixelFormat.TRANSLUCENT,
            ).apply {
                gravity =
                    Gravity.TOP or Gravity.START
                x = screenWidth()
                    .minus(width + dp(12))
                    .coerceAtLeast(0)
                y = dp(84)
            }

        val webView = WebView(this).apply {
            setBackgroundColor(Color.TRANSPARENT)
            setLayerType(
                View.LAYER_TYPE_HARDWARE,
                null,
            )

            settings.javaScriptEnabled = true
            settings.domStorageEnabled = true
            settings.allowFileAccess = true
            settings.allowContentAccess = true

            @Suppress("DEPRECATION")
            settings.allowFileAccessFromFileURLs =
                true
            @Suppress("DEPRECATION")
            settings.allowUniversalAccessFromFileURLs =
                true

            webViewClient =
                object : WebViewClient() {
                    override fun onPageFinished(
                        view: WebView?,
                        url: String?,
                    ) {
                        pageReady = true
                        applyLatestState()
                    }
                }

            loadUrl(
                "file:///android_asset/flutter_assets/assets/avatar/jarvis_human_avatar.html",
            )
        }

        try {
            windowManager.addView(
                webView,
                params,
            )
        } catch (_: Throwable) {
            webView.destroy()
            stopSelf()
            return
        }

        avatarView = webView
        layoutParams = params

        handler.removeCallbacks(
            wanderRunnable,
        )
        handler.postDelayed(
            wanderRunnable,
            2800L,
        )
    }

    private fun applyLatestState() {
        if (!pageReady) {
            return
        }

        val webView = avatarView ?: return
        val script =
            "window.jarvisSetState($lastStateJson);"

        webView.post {
            try {
                webView.evaluateJavascript(
                    script,
                    null,
                )
            } catch (_: Throwable) {
                // State will be retried on the next update.
            }
        }
    }

    private fun moveToNextPosition() {
        val view = avatarView ?: return
        val params = layoutParams ?: return

        val maxX =
            (screenWidth() - params.width)
                .coerceAtLeast(0)
        val maxY =
            (
                screenHeight() -
                    params.height -
                    dp(72)
                )
                .coerceAtLeast(dp(72))

        val top =
            dp(72).coerceAtMost(maxY)

        val targets = listOf(
            Pair(
                dp(8).coerceAtMost(maxX),
                maxY,
            ),
            Pair(
                maxX,
                maxY,
            ),
            Pair(
                maxX / 2,
                maxY,
            ),
            Pair(
                maxX,
                (maxY * 0.48)
                    .roundToInt()
                    .coerceAtLeast(top),
            ),
            Pair(
                dp(8).coerceAtMost(maxX),
                (maxY * 0.62)
                    .roundToInt()
                    .coerceAtLeast(top),
            ),
        )

        targetIndex =
            (targetIndex + 1) % targets.size

        val target = targets[targetIndex]
        val startX = params.x
        val startY = params.y

        movementAnimator?.cancel()
        movementAnimator =
            ValueAnimator
                .ofFloat(0f, 1f)
                .apply {
                    duration = 2200L
                    interpolator =
                        AccelerateDecelerateInterpolator()

                    addUpdateListener {
                        val fraction =
                            it.animatedFraction

                        params.x =
                            (
                                startX +
                                    (
                                        target.first -
                                            startX
                                        ) *
                                    fraction
                                ).roundToInt()

                        params.y =
                            (
                                startY +
                                    (
                                        target.second -
                                            startY
                                        ) *
                                    fraction
                                ).roundToInt()

                        try {
                            windowManager
                                .updateViewLayout(
                                    view,
                                    params,
                                )
                        } catch (_: Throwable) {
                            // Ignore transient detach/race conditions.
                        }
                    }

                    start()
                }
    }

    private fun screenWidth(): Int =
        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.R
        ) {
            windowManager
                .currentWindowMetrics
                .bounds
                .width()
        } else {
            @Suppress("DEPRECATION")
            resources.displayMetrics.widthPixels
        }

    private fun screenHeight(): Int =
        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.R
        ) {
            windowManager
                .currentWindowMetrics
                .bounds
                .height()
        } else {
            @Suppress("DEPRECATION")
            resources.displayMetrics.heightPixels
        }

    private fun dp(value: Int): Int =
        (
            value *
                resources
                    .displayMetrics
                    .density
            ).roundToInt()
}
