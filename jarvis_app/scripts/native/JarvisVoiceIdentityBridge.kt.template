package __PACKAGE__

import android.Manifest
import android.app.Activity
import android.content.Context
import android.content.pm.PackageManager
import android.media.AudioFormat
import android.media.AudioRecord
import android.media.MediaRecorder
import android.security.keystore.KeyGenParameterSpec
import android.security.keystore.KeyProperties
import android.util.Base64
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import java.io.File
import java.io.FileOutputStream
import java.net.HttpURLConnection
import java.net.URL
import java.nio.charset.StandardCharsets
import java.security.KeyStore
import javax.crypto.Cipher
import javax.crypto.KeyGenerator
import javax.crypto.SecretKey
import javax.crypto.spec.GCMParameterSpec
import kotlin.math.max
import kotlin.math.sqrt
import org.json.JSONArray
import org.pytorch.executorch.EValue
import org.pytorch.executorch.Module
import org.pytorch.executorch.Tensor

object JarvisVoiceIdentityBridge {
    private const val CHANNEL = "jarvis.voice_identity"
    private const val SAMPLE_RATE = 16000
    private const val SAMPLE_COUNT = 48000
    private const val MODEL_URL =
        "https://huggingface.co/mlboydaisuke/ECAPA-TDNN-Speaker-ExecuTorch/resolve/main/speaker_ecapa_xnnpack_fp32.pte?download=true"
    private const val MODEL_FILE = "speaker_ecapa_xnnpack_fp32.pte"
    private const val MODEL_PART_FILE = "speaker_ecapa_xnnpack_fp32.pte.part"
    private const val MIN_MODEL_BYTES = 80_000_000L
    private const val PREFS = "jarvis_voice_profiles"
    private const val KEY_ALIAS = "jarvis_voice_profile_key"
    private const val MATCH_THRESHOLD = 0.60f
    private const val MATCH_MARGIN = 0.08f

    @Volatile
    private var module: Module? = null

    fun register(
        activity: Activity,
        flutterEngine: FlutterEngine,
    ) {
        MethodChannel(
            flutterEngine.dartExecutor.binaryMessenger,
            CHANNEL,
        ).setMethodCallHandler { call, result ->
            when (call.method) {
                "enrollVoice" -> {
                    val personId =
                        call.argument<String>("personId")
                            ?.trim()
                            .orEmpty()

                    if (personId.isEmpty()) {
                        result.error(
                            "invalid_person",
                            "A person ID is required.",
                            null,
                        )
                        return@setMethodCallHandler
                    }

                    runAsync(activity, result) {
                        ensureMicrophonePermission(activity)
                        val embedding = captureEmbedding(activity)
                        saveEmbedding(activity, personId, embedding)
                        mapOf(
                            "personId" to personId,
                            "sampleSeconds" to 3,
                            "embeddingSize" to embedding.size,
                        )
                    }
                }

                "identifySpeaker" -> {
                    runAsync(activity, result) {
                        ensureMicrophonePermission(activity)
                        val ids = listProfileIds(activity)

                        if (ids.isEmpty()) {
                            return@runAsync mapOf(
                                "matched" to false,
                                "personId" to "",
                                "similarity" to 0.0,
                                "secondSimilarity" to 0.0,
                                "threshold" to MATCH_THRESHOLD.toDouble(),
                                "margin" to MATCH_MARGIN.toDouble(),
                                "reason" to "no_profiles",
                            )
                        }

                        val probe = captureEmbedding(activity)
                        identify(activity, ids, probe)
                    }
                }

                "hasVoiceProfile" -> {
                    val personId =
                        call.argument<String>("personId")
                            ?.trim()
                            .orEmpty()

                    result.success(
                        personId.isNotEmpty() &&
                            hasProfile(activity, personId),
                    )
                }

                "listVoiceProfileIds" -> {
                    result.success(listProfileIds(activity))
                }

                "deleteVoiceProfile" -> {
                    val personId =
                        call.argument<String>("personId")
                            ?.trim()
                            .orEmpty()

                    if (personId.isNotEmpty()) {
                        activity
                            .getSharedPreferences(
                                PREFS,
                                Context.MODE_PRIVATE,
                            )
                            .edit()
                            .remove(profileKey(personId))
                            .apply()
                    }

                    result.success(true)
                }

                else -> result.notImplemented()
            }
        }
    }

    private fun ensureMicrophonePermission(activity: Activity) {
        if (
            activity.checkSelfPermission(
                Manifest.permission.RECORD_AUDIO,
            ) != PackageManager.PERMISSION_GRANTED
        ) {
            throw IllegalStateException(
                "Microphone permission is required for voice identity.",
            )
        }
    }

    private fun runAsync(
        activity: Activity,
        result: MethodChannel.Result,
        block: () -> Any?,
    ) {
        Thread {
            try {
                val value = block()
                activity.runOnUiThread {
                    result.success(value)
                }
            } catch (error: Throwable) {
                activity.runOnUiThread {
                    result.error(
                        "voice_identity_failed",
                        error.message
                            ?: "Voice identity operation failed.",
                        null,
                    )
                }
            }
        }.start()
    }

    private fun captureEmbedding(
        activity: Activity,
    ): FloatArray {
        val samples = capturePcm()
        return runEmbedding(activity, samples)
    }

    private fun capturePcm(): FloatArray {
        val minBuffer = AudioRecord.getMinBufferSize(
            SAMPLE_RATE,
            AudioFormat.CHANNEL_IN_MONO,
            AudioFormat.ENCODING_PCM_16BIT,
        )

        if (minBuffer <= 0) {
            throw IllegalStateException(
                "Android could not initialize microphone capture.",
            )
        }

        val bufferSize = max(
            minBuffer,
            SAMPLE_COUNT * 2,
        )

        val recorder = AudioRecord(
            MediaRecorder.AudioSource.VOICE_RECOGNITION,
            SAMPLE_RATE,
            AudioFormat.CHANNEL_IN_MONO,
            AudioFormat.ENCODING_PCM_16BIT,
            bufferSize,
        )

        if (
            recorder.state !=
                AudioRecord.STATE_INITIALIZED
        ) {
            recorder.release()
            throw IllegalStateException(
                "Microphone could not be initialized.",
            )
        }

        val pcm = ShortArray(SAMPLE_COUNT)
        var offset = 0

        try {
            recorder.startRecording()

            while (offset < SAMPLE_COUNT) {
                val read = recorder.read(
                    pcm,
                    offset,
                    SAMPLE_COUNT - offset,
                    AudioRecord.READ_BLOCKING,
                )

                if (read <= 0) {
                    throw IllegalStateException(
                        "Microphone capture stopped unexpectedly.",
                    )
                }

                offset += read
            }
        } finally {
            try {
                recorder.stop()
            } catch (_: Throwable) {
                // Best-effort cleanup.
            }
            recorder.release()
        }

        val waveform = FloatArray(SAMPLE_COUNT)
        var energy = 0.0

        for (index in pcm.indices) {
            val value = pcm[index] / 32768.0f
            waveform[index] = value
            energy += value * value
        }

        val rms = sqrt(energy / SAMPLE_COUNT)

        if (rms < 0.008) {
            throw IllegalStateException(
                "Not enough speech was detected. Speak clearly for the full three seconds.",
            )
        }

        return waveform
    }

    private fun runEmbedding(
        activity: Activity,
        waveform: FloatArray,
    ): FloatArray {
        val model = getModule(activity)
        val input = Tensor.fromBlob(
            waveform,
            longArrayOf(1, SAMPLE_COUNT.toLong()),
        )

        val output = model.forward(
            EValue.from(input),
        )

        if (output.isEmpty()) {
            throw IllegalStateException(
                "Speaker model returned no output.",
            )
        }

        val raw = output[0]
            .toTensor()
            .dataAsFloatArray

        if (raw.isEmpty()) {
            throw IllegalStateException(
                "Speaker model returned an empty embedding.",
            )
        }

        return l2Normalize(raw)
    }

    @Synchronized
    private fun getModule(activity: Activity): Module {
        module?.let { return it }

        val modelFile = File(
            activity.filesDir,
            MODEL_FILE,
        )

        if (
            !modelFile.exists() ||
            modelFile.length() < MIN_MODEL_BYTES
        ) {
            downloadModel(activity, modelFile)
        }

        return Module.load(
            modelFile.absolutePath,
        ).also {
            module = it
        }
    }

    private fun downloadModel(
        activity: Activity,
        modelFile: File,
    ) {
        val partial = File(
            activity.filesDir,
            MODEL_PART_FILE,
        )

        var lastError: Throwable? = null

        repeat(4) { attempt ->
            var connection: HttpURLConnection? = null

            try {
                val existingBytes =
                    if (partial.exists()) partial.length() else 0L

                connection =
                    (URL(MODEL_URL).openConnection() as HttpURLConnection)
                        .apply {
                            instanceFollowRedirects = true
                            connectTimeout = 30_000
                            readTimeout = 120_000
                            requestMethod = "GET"
                            setRequestProperty(
                                "User-Agent",
                                "JARVIS-Android/1.3",
                            )
                            if (existingBytes > 0L) {
                                setRequestProperty(
                                    "Range",
                                    "bytes=${existingBytes}-",
                                )
                            }
                        }

                val responseCode = connection.responseCode
                val append =
                    existingBytes > 0L &&
                        responseCode == HttpURLConnection.HTTP_PARTIAL

                if (
                    responseCode !in 200..299
                ) {
                    throw IllegalStateException(
                        "Voice model download failed with HTTP $responseCode.",
                    )
                }

                if (!append && partial.exists()) {
                    partial.delete()
                }

                connection.inputStream.use { input ->
                    FileOutputStream(
                        partial,
                        append,
                    ).buffered().use { output ->
                        input.copyTo(output)
                    }
                }

                if (partial.length() < MIN_MODEL_BYTES) {
                    throw IllegalStateException(
                        "Voice model download was incomplete.",
                    )
                }

                if (modelFile.exists()) {
                    modelFile.delete()
                }

                if (!partial.renameTo(modelFile)) {
                    partial.inputStream().use { input ->
                        modelFile.outputStream().use { output ->
                            input.copyTo(output)
                        }
                    }
                    partial.delete()
                }

                if (modelFile.length() < MIN_MODEL_BYTES) {
                    modelFile.delete()
                    throw IllegalStateException(
                        "Voice model could not be verified after download.",
                    )
                }

                return
            } catch (error: Throwable) {
                lastError = error
                if (attempt < 3) {
                    try {
                        Thread.sleep(1_500L * (attempt + 1))
                    } catch (_: InterruptedException) {
                        Thread.currentThread().interrupt()
                    }
                }
            } finally {
                connection?.disconnect()
            }
        }

        throw IllegalStateException(
            "JARVIS could not download the voice identity model. Check your internet connection and try voice identity again.",
            lastError,
        )
    }

    private fun identify(
        activity: Activity,
        profileIds: List<String>,
        probe: FloatArray,
    ): Map<String, Any> {
        var bestId = ""
        var best = -1.0f
        var second = -1.0f

        for (personId in profileIds) {
            val enrolled =
                loadEmbedding(activity, personId)
                    ?: continue

            val similarity =
                cosine(probe, enrolled)

            if (similarity > best) {
                second = best
                best = similarity
                bestId = personId
            } else if (similarity > second) {
                second = similarity
            }
        }

        val separation =
            if (second < -0.5f) {
                1.0f
            } else {
                best - second
            }

        val matched =
            bestId.isNotEmpty() &&
            best >= MATCH_THRESHOLD &&
            separation >= MATCH_MARGIN

        return mapOf(
            "matched" to matched,
            "personId" to if (matched) bestId else "",
            "similarity" to best.toDouble(),
            "secondSimilarity" to second.toDouble(),
            "separation" to separation.toDouble(),
            "threshold" to MATCH_THRESHOLD.toDouble(),
            "margin" to MATCH_MARGIN.toDouble(),
            "reason" to when {
                matched -> "matched"
                best < MATCH_THRESHOLD -> "below_threshold"
                else -> "ambiguous"
            },
        )
    }

    private fun cosine(
        left: FloatArray,
        right: FloatArray,
    ): Float {
        if (
            left.isEmpty() ||
            right.isEmpty() ||
            left.size != right.size
        ) {
            return -1.0f
        }

        var dot = 0.0
        var leftNorm = 0.0
        var rightNorm = 0.0

        for (index in left.indices) {
            val a = left[index].toDouble()
            val b = right[index].toDouble()
            dot += a * b
            leftNorm += a * a
            rightNorm += b * b
        }

        if (
            leftNorm <= 0.0 ||
            rightNorm <= 0.0
        ) {
            return -1.0f
        }

        return (
            dot /
                (sqrt(leftNorm) * sqrt(rightNorm))
            ).toFloat()
    }

    private fun l2Normalize(
        values: FloatArray,
    ): FloatArray {
        var norm = 0.0

        for (value in values) {
            norm += value * value
        }

        val length = sqrt(norm)
        if (length <= 0.0) {
            return values
        }

        return FloatArray(values.size) { index ->
            (values[index] / length).toFloat()
        }
    }

    private fun saveEmbedding(
        activity: Activity,
        personId: String,
        embedding: FloatArray,
    ) {
        val json = JSONArray()
        embedding.forEach { value ->
            json.put(value.toDouble())
        }

        val encrypted = encrypt(
            json.toString()
                .toByteArray(StandardCharsets.UTF_8),
        )

        activity
            .getSharedPreferences(
                PREFS,
                Context.MODE_PRIVATE,
            )
            .edit()
            .putString(
                profileKey(personId),
                encrypted,
            )
            .apply()
    }

    private fun loadEmbedding(
        activity: Activity,
        personId: String,
    ): FloatArray? {
        val encoded = activity
            .getSharedPreferences(
                PREFS,
                Context.MODE_PRIVATE,
            )
            .getString(
                profileKey(personId),
                null,
            )
            ?: return null

        val decrypted =
            decrypt(encoded)

        val json = JSONArray(
            String(
                decrypted,
                StandardCharsets.UTF_8,
            ),
        )

        return FloatArray(json.length()) { index ->
            json.getDouble(index).toFloat()
        }
    }

    private fun listProfileIds(
        activity: Activity,
    ): List<String> {
        return activity
            .getSharedPreferences(
                PREFS,
                Context.MODE_PRIVATE,
            )
            .all
            .keys
            .asSequence()
            .filter {
                it.startsWith("profile_")
            }
            .map {
                it.removePrefix("profile_")
            }
            .sorted()
            .toList()
    }

    private fun hasProfile(
        activity: Activity,
        personId: String,
    ): Boolean {
        return activity
            .getSharedPreferences(
                PREFS,
                Context.MODE_PRIVATE,
            )
            .contains(profileKey(personId))
    }

    private fun profileKey(
        personId: String,
    ): String {
        return "profile_$personId"
    }

    private fun encrypt(
        plaintext: ByteArray,
    ): String {
        val cipher =
            Cipher.getInstance(
                "AES/GCM/NoPadding",
            )

        cipher.init(
            Cipher.ENCRYPT_MODE,
            getOrCreateKey(),
        )

        val ciphertext =
            cipher.doFinal(plaintext)

        val combined = ByteArray(
            cipher.iv.size + ciphertext.size,
        )

        System.arraycopy(
            cipher.iv,
            0,
            combined,
            0,
            cipher.iv.size,
        )
        System.arraycopy(
            ciphertext,
            0,
            combined,
            cipher.iv.size,
            ciphertext.size,
        )

        return Base64.encodeToString(
            combined,
            Base64.NO_WRAP,
        )
    }

    private fun decrypt(
        encoded: String,
    ): ByteArray {
        val combined = Base64.decode(
            encoded,
            Base64.NO_WRAP,
        )

        if (combined.size <= 12) {
            throw IllegalStateException(
                "Stored voice profile is invalid.",
            )
        }

        val iv = combined.copyOfRange(
            0,
            12,
        )
        val ciphertext =
            combined.copyOfRange(
                12,
                combined.size,
            )

        val cipher =
            Cipher.getInstance(
                "AES/GCM/NoPadding",
            )

        cipher.init(
            Cipher.DECRYPT_MODE,
            getOrCreateKey(),
            GCMParameterSpec(
                128,
                iv,
            ),
        )

        return cipher.doFinal(ciphertext)
    }

    private fun getOrCreateKey(): SecretKey {
        val keyStore =
            KeyStore.getInstance(
                "AndroidKeyStore",
            ).apply {
                load(null)
            }

        val existing =
            keyStore.getKey(
                KEY_ALIAS,
                null,
            ) as? SecretKey

        if (existing != null) {
            return existing
        }

        val generator =
            KeyGenerator.getInstance(
                KeyProperties.KEY_ALGORITHM_AES,
                "AndroidKeyStore",
            )

        generator.init(
            KeyGenParameterSpec.Builder(
                KEY_ALIAS,
                KeyProperties.PURPOSE_ENCRYPT or
                    KeyProperties.PURPOSE_DECRYPT,
            )
                .setBlockModes(
                    KeyProperties.BLOCK_MODE_GCM,
                )
                .setEncryptionPaddings(
                    KeyProperties.ENCRYPTION_PADDING_NONE,
                )
                .setKeySize(256)
                .build(),
        )

        return generator.generateKey()
    }
}
