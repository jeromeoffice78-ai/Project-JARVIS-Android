package __PACKAGE__

import android.app.Activity
import android.app.ActivityManager
import android.bluetooth.BluetoothManager
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.content.pm.ApplicationInfo
import android.content.pm.PackageManager
import android.net.ConnectivityManager
import android.net.NetworkCapabilities
import android.net.Uri
import android.os.BatteryManager
import android.os.Build
import android.os.Environment
import android.os.StatFs
import android.provider.Settings
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import java.io.File
import java.time.LocalDate
import kotlin.math.roundToInt

object JarvisDeviceRepairBridge {
    private const val CHANNEL = "jarvis.device_repair"

    fun register(
        activity: Activity,
        flutterEngine: FlutterEngine,
    ) {
        MethodChannel(
            flutterEngine.dartExecutor.binaryMessenger,
            CHANNEL,
        ).setMethodCallHandler { call, result ->
            when (call.method) {
                "diagnose" -> {
                    result.success(
                        diagnose(activity),
                    )
                }

                "scanApps" -> {
                    result.success(
                        scanVisibleApps(activity),
                    )
                }

                "clearJarvisCache" -> {
                    result.success(
                        clearCache(activity.cacheDir),
                    )
                }

                "openRepairSettings" -> {
                    val target =
                        call.argument<String>("target")
                            ?.trim()
                            .orEmpty()
                    result.success(
                        openRepairSettings(
                            activity,
                            target,
                        ),
                    )
                }

                "openAppDetails" -> {
                    val packageName =
                        call.argument<String>("packageName")
                            ?.trim()
                            .orEmpty()
                    result.success(
                        openAppDetails(
                            activity,
                            packageName,
                        ),
                    )
                }

                "requestUninstall" -> {
                    val packageName =
                        call.argument<String>("packageName")
                            ?.trim()
                            .orEmpty()
                    result.success(
                        requestUninstall(
                            activity,
                            packageName,
                        ),
                    )
                }

                "isPackageInstalled" -> {
                    val packageName =
                        call.argument<String>("packageName")
                            ?.trim()
                            .orEmpty()
                    result.success(
                        isPackageInstalled(
                            activity,
                            packageName,
                        ),
                    )
                }

                else -> result.notImplemented()
            }
        }
    }

    private fun diagnose(
        context: Context,
    ): Map<String, Any?> {
        val memoryInfo =
            ActivityManager.MemoryInfo()

        val activityManager =
            context.getSystemService(
                Context.ACTIVITY_SERVICE,
            ) as ActivityManager

        activityManager.getMemoryInfo(
            memoryInfo,
        )

        val stat = StatFs(
            Environment
                .getDataDirectory()
                .absolutePath,
        )

        val totalStorage =
            stat.totalBytes
        val freeStorage =
            stat.availableBytes

        val batteryIntent =
            context.registerReceiver(
                null,
                IntentFilter(
                    Intent.ACTION_BATTERY_CHANGED,
                ),
            )

        val batteryLevelRaw =
            batteryIntent?.getIntExtra(
                BatteryManager.EXTRA_LEVEL,
                -1,
            ) ?: -1
        val batteryScale =
            batteryIntent?.getIntExtra(
                BatteryManager.EXTRA_SCALE,
                100,
            ) ?: 100

        val batteryPercent =
            if (
                batteryLevelRaw >= 0 &&
                batteryScale > 0
            ) {
                (
                    batteryLevelRaw *
                        100.0 /
                        batteryScale
                    ).roundToInt()
            } else {
                -1
            }

        val batteryStatus =
            batteryIntent?.getIntExtra(
                BatteryManager.EXTRA_STATUS,
                -1,
            ) ?: -1

        val batteryHealth =
            batteryIntent?.getIntExtra(
                BatteryManager.EXTRA_HEALTH,
                BatteryManager
                    .BATTERY_HEALTH_UNKNOWN,
            ) ?: BatteryManager
                .BATTERY_HEALTH_UNKNOWN

        val batteryTemperature =
            batteryIntent?.getIntExtra(
                BatteryManager.EXTRA_TEMPERATURE,
                -1,
            ) ?: -1

        val connectivity =
            context.getSystemService(
                Context.CONNECTIVITY_SERVICE,
            ) as ConnectivityManager

        val activeNetwork =
            connectivity.activeNetwork

        val networkCapabilities =
            activeNetwork?.let {
                connectivity
                    .getNetworkCapabilities(it)
            }

        val hasInternet =
            networkCapabilities?.hasCapability(
                NetworkCapabilities
                    .NET_CAPABILITY_INTERNET,
            ) == true

        val validatedInternet =
            networkCapabilities?.hasCapability(
                NetworkCapabilities
                    .NET_CAPABILITY_VALIDATED,
            ) == true

        val bluetoothEnabled =
            try {
                val bluetoothManager =
                    context.getSystemService(
                        Context.BLUETOOTH_SERVICE,
                    ) as BluetoothManager
                bluetoothManager
                    .adapter
                    ?.isEnabled
            } catch (_: Throwable) {
                null
            }

        val freeRatio =
            if (totalStorage > 0) {
                freeStorage.toDouble() /
                    totalStorage.toDouble()
            } else {
                1.0
            }

        val lowStorage =
            freeStorage <
                1024L * 1024L * 1024L ||
                freeRatio < 0.10

        val issues =
            mutableListOf<
                Map<String, Any?>>()

        if (lowStorage) {
            issues.add(
                mapOf(
                    "code" to "low_storage",
                    "severity" to "high",
                    "summary" to
                        "Internal storage is low.",
                    "repair" to "storage",
                ),
            )
        }

        if (memoryInfo.lowMemory) {
            issues.add(
                mapOf(
                    "code" to "low_memory",
                    "severity" to "medium",
                    "summary" to
                        "Android reports low available memory.",
                    "repair" to "apps",
                ),
            )
        }

        if (
            hasInternet &&
            !validatedInternet
        ) {
            issues.add(
                mapOf(
                    "code" to
                        "internet_not_validated",
                    "severity" to "medium",
                    "summary" to
                        "A network is connected but Android cannot validate internet access.",
                    "repair" to "internet",
                ),
            )
        }

        if (!hasInternet) {
            issues.add(
                mapOf(
                    "code" to "offline",
                    "severity" to "medium",
                    "summary" to
                        "No active internet-capable network is available.",
                    "repair" to "internet",
                ),
            )
        }

        if (
            batteryHealth !=
                BatteryManager
                    .BATTERY_HEALTH_GOOD &&
            batteryHealth !=
                BatteryManager
                    .BATTERY_HEALTH_UNKNOWN
        ) {
            issues.add(
                mapOf(
                    "code" to
                        "battery_health",
                    "severity" to "high",
                    "summary" to
                        "Android reports a battery-health warning.",
                    "repair" to "battery",
                ),
            )
        }

        if (bluetoothEnabled == false) {
            issues.add(
                mapOf(
                    "code" to
                        "bluetooth_disabled",
                    "severity" to "low",
                    "summary" to
                        "Bluetooth is disabled.",
                    "repair" to "bluetooth",
                ),
            )
        }

        if (
            batteryPercent in 0..9 &&
            batteryStatus !=
                BatteryManager
                    .BATTERY_STATUS_CHARGING &&
            batteryStatus !=
                BatteryManager
                    .BATTERY_STATUS_FULL
        ) {
            issues.add(
                mapOf(
                    "code" to
                        "battery_critical",
                    "severity" to "medium",
                    "summary" to
                        "Battery level is critically low.",
                    "repair" to "battery",
                ),
            )
        }

        if (batteryTemperature >= 450) {
            issues.add(
                mapOf(
                    "code" to
                        "battery_hot",
                    "severity" to "high",
                    "summary" to
                        "Battery temperature is unusually high.",
                    "repair" to "battery",
                ),
            )
        }

        val securityPatch =
            Build.VERSION.SECURITY_PATCH
                ?.trim()
                .orEmpty()

        if (securityPatch.isNotEmpty()) {
            try {
                val patchDate =
                    LocalDate.parse(
                        securityPatch,
                    )
                val staleBefore =
                    LocalDate.now()
                        .minusDays(180)

                if (
                    patchDate.isBefore(
                        staleBefore,
                    )
                ) {
                    issues.add(
                        mapOf(
                            "code" to
                                "security_patch_old",
                            "severity" to
                                "medium",
                            "summary" to
                                "Android security patch is more than 180 days old.",
                            "repair" to
                                "system_update",
                        ),
                    )
                }
            } catch (_: Throwable) {
                // Some vendors use non-standard patch strings.
            }
        }

        return mapOf(
            "manufacturer" to
                Build.MANUFACTURER,
            "model" to Build.MODEL,
            "androidVersion" to
                Build.VERSION.RELEASE,
            "sdk" to
                Build.VERSION.SDK_INT,
            "securityPatch" to
                Build.VERSION.SECURITY_PATCH,
            "memory" to mapOf(
                "availableBytes" to
                    memoryInfo.availMem,
                "totalBytes" to
                    memoryInfo.totalMem,
                "lowMemory" to
                    memoryInfo.lowMemory,
                "thresholdBytes" to
                    memoryInfo.threshold,
            ),
            "storage" to mapOf(
                "availableBytes" to
                    freeStorage,
                "totalBytes" to
                    totalStorage,
                "low" to lowStorage,
            ),
            "battery" to mapOf(
                "percent" to
                    batteryPercent,
                "status" to
                    batteryStatus,
                "health" to
                    batteryHealth,
                "temperatureC" to
                    if (
                        batteryTemperature >= 0
                    ) {
                        batteryTemperature /
                            10.0
                    } else {
                        null
                    },
            ),
            "network" to mapOf(
                "hasInternetCapability" to
                    hasInternet,
                "validated" to
                    validatedInternet,
            ),
            "bluetooth" to mapOf(
                "enabled" to
                    bluetoothEnabled,
            ),
            "issues" to issues,
        )
    }

    private fun scanVisibleApps(
        context: Context,
    ): List<Map<String, Any?>> {
        val packageManager =
            context.packageManager

        val launcherIntent =
            Intent(Intent.ACTION_MAIN).apply {
                addCategory(
                    Intent.CATEGORY_LAUNCHER,
                )
            }

        @Suppress("DEPRECATION")
        val activities =
            packageManager
                .queryIntentActivities(
                    launcherIntent,
                    PackageManager.MATCH_ALL,
                )

        val packages =
            linkedSetOf<String>()

        try {
            val installed =
                if (
                    Build.VERSION.SDK_INT >= 33
                ) {
                    packageManager
                        .getInstalledPackages(
                            PackageManager
                                .PackageInfoFlags
                                .of(0),
                        )
                } else {
                    @Suppress("DEPRECATION")
                    packageManager
                        .getInstalledPackages(0)
                }

            installed.forEach {
                packages.add(
                    it.packageName,
                )
            }
        } catch (_: Throwable) {
            // Android package visibility rules may limit this list.
        }

        activities.forEach {
            packages.add(
                it.activityInfo.packageName,
            )
        }

        val riskyServiceActions =
            listOf(
                "android.accessibilityservice.AccessibilityService",
                "android.service.notification.NotificationListenerService",
            )

        riskyServiceActions.forEach { action ->
            val intent = Intent(action)

            @Suppress("DEPRECATION")
            packageManager
                .queryIntentServices(
                    intent,
                    PackageManager.MATCH_ALL,
                )
                .forEach {
                    packages.add(
                        it.serviceInfo.packageName,
                    )
                }
        }

        @Suppress("DEPRECATION")
        packageManager
            .queryBroadcastReceivers(
                Intent(
                    "android.app.action.DEVICE_ADMIN_ENABLED",
                ),
                PackageManager.MATCH_ALL,
            )
            .forEach {
                packages.add(
                    it.activityInfo.packageName,
                )
            }

        packages.add(
            context.packageName,
        )

        return packages
            .mapNotNull { packageName ->
                try {
                    appRisk(
                        context,
                        packageName,
                    )
                } catch (_: Throwable) {
                    null
                }
            }
            .sortedByDescending {
                (it["riskScore"]
                    as? Number)
                    ?.toInt() ?: 0
            }
    }

    @Suppress("DEPRECATION")
    private fun appRisk(
        context: Context,
        packageName: String,
    ): Map<String, Any?> {
        val packageManager =
            context.packageManager

        val packageFlags =
            PackageManager.GET_PERMISSIONS or
                PackageManager.GET_SERVICES or
                PackageManager.GET_RECEIVERS

        val packageInfo =
            if (
                Build.VERSION.SDK_INT >= 33
            ) {
                packageManager.getPackageInfo(
                    packageName,
                    PackageManager
                        .PackageInfoFlags
                        .of(
                            packageFlags.toLong(),
                        ),
                )
            } else {
                packageManager
                    .getPackageInfo(
                        packageName,
                        packageFlags,
                    )
            }

        val applicationInfo =
            packageInfo.applicationInfo

        val label =
            applicationInfo
                ?.loadLabel(packageManager)
                ?.toString()
                ?: packageName

        val systemApp =
            (
                applicationInfo?.flags ?: 0
                ) and
                ApplicationInfo
                    .FLAG_SYSTEM !=
                0

        val permissions =
            packageInfo
                .requestedPermissions
                ?.toSet()
                .orEmpty()

        val hasAccessibilityService =
            packageInfo
                .services
                ?.any {
                    it.permission ==
                        "android.permission.BIND_ACCESSIBILITY_SERVICE"
                } == true

        val hasNotificationListener =
            packageInfo
                .services
                ?.any {
                    it.permission ==
                        "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
                } == true

        val hasDeviceAdminReceiver =
            packageInfo
                .receivers
                ?.any {
                    it.permission ==
                        "android.permission.BIND_DEVICE_ADMIN"
                } == true

        var score = 0
        val reasons =
            mutableListOf<String>()

        fun flag(
            points: Int,
            reason: String,
        ) {
            score += points
            reasons.add(reason)
        }

        if (packageName == context.packageName) {
            reasons.add(
                "This is the JARVIS app itself; it is not scored as suspicious.",
            )
        }

        if (
            packageName != context.packageName &&
            "android.permission.REQUEST_INSTALL_PACKAGES"
                in permissions
        ) {
            flag(
                2,
                "Can request installation of APK packages.",
            )
        }

        if (
            packageName != context.packageName &&
            "android.permission.SYSTEM_ALERT_WINDOW"
                in permissions
        ) {
            flag(
                2,
                "Requests display-over-other-apps access.",
            )
        }

        if (
            packageName != context.packageName &&
            (
                "android.permission.READ_SMS"
                    in permissions ||
                "android.permission.RECEIVE_SMS"
                    in permissions
            )
        ) {
            flag(
                2,
                "Requests SMS access.",
            )
        }

        if (
            packageName != context.packageName &&
            (
                "android.permission.READ_CALL_LOG"
                    in permissions ||
                "android.permission.WRITE_CALL_LOG"
                    in permissions
            )
        ) {
            flag(
                2,
                "Requests call-log access.",
            )
        }

        if (
            packageName != context.packageName &&
            "android.permission.RECORD_AUDIO"
                in permissions &&
            "android.permission.CAMERA"
                in permissions
        ) {
            flag(
                1,
                "Requests both camera and microphone access.",
            )
        }

        if (
            packageName != context.packageName &&
            "android.permission.RECEIVE_BOOT_COMPLETED"
                in permissions
        ) {
            flag(
                1,
                "Can start work after device boot.",
            )
        }

        if (
            packageName != context.packageName &&
            hasAccessibilityService
        ) {
            flag(
                3,
                "Declares an accessibility service capable of observing or controlling screen interaction.",
            )
        }

        if (
            packageName != context.packageName &&
            hasNotificationListener
        ) {
            flag(
                2,
                "Declares a notification-listener service.",
            )
        }

        if (
            packageName != context.packageName &&
            hasDeviceAdminReceiver
        ) {
            flag(
                3,
                "Declares device-administrator capability.",
            )
        }

        val overlayRequested =
            "android.permission.SYSTEM_ALERT_WINDOW" in
                permissions
        val installRequested =
            "android.permission.REQUEST_INSTALL_PACKAGES" in
                permissions
        val smsRequested =
            "android.permission.READ_SMS" in permissions ||
                "android.permission.RECEIVE_SMS" in permissions
        val callLogRequested =
            "android.permission.READ_CALL_LOG" in permissions ||
                "android.permission.WRITE_CALL_LOG" in permissions
        val bootPersistence =
            "android.permission.RECEIVE_BOOT_COMPLETED" in
                permissions

        if (
            packageName != context.packageName &&
            overlayRequested &&
            hasAccessibilityService
        ) {
            flag(
                4,
                "High-risk combination: display-over-apps plus accessibility service.",
            )
        }

        if (
            packageName != context.packageName &&
            installRequested &&
            (smsRequested || callLogRequested)
        ) {
            flag(
                3,
                "High-risk combination: APK installation plus SMS/call-log access.",
            )
        }

        if (
            packageName != context.packageName &&
            bootPersistence &&
            (overlayRequested ||
                hasAccessibilityService ||
                hasNotificationListener)
        ) {
            flag(
                2,
                "Persistence combination: starts after boot with elevated screen/notification capabilities.",
            )
        }

        val installer =
            try {
                if (
                    Build.VERSION.SDK_INT >=
                    Build.VERSION_CODES.R
                ) {
                    packageManager
                        .getInstallSourceInfo(
                            packageName,
                        )
                        .installingPackageName
                } else {
                    packageManager
                        .getInstallerPackageName(
                            packageName,
                        )
                }
            } catch (_: Throwable) {
                null
            }

        val trustedInstallers =
            setOf(
                "com.android.vending",
                "com.google.android.packageinstaller",
                "com.android.packageinstaller",
                "com.sec.android.app.samsungapps",
                "com.amazon.venezia",
            )

        if (
            !systemApp &&
            installer != null &&
            installer !in trustedInstallers
        ) {
            flag(
                2,
                "Installed by an unrecognized installer: $installer",
            )
        }

        if (
            !systemApp &&
            installer == null &&
            packageName != context.packageName
        ) {
            flag(
                1,
                "Installer source is unavailable.",
            )
        }

        val cappedScore =
            score.coerceIn(0, 10)

        return mapOf(
            "label" to label,
            "packageName" to
                packageName,
            "systemApp" to
                systemApp,
            "installer" to
                installer,
            "firstInstallTime" to
                packageInfo.firstInstallTime,
            "lastUpdateTime" to
                packageInfo.lastUpdateTime,
            "riskScore" to
                cappedScore,
            "riskLevel" to
                when {
                    cappedScore >= 6 ->
                        "high"
                    cappedScore >= 3 ->
                        "medium"
                    else -> "low"
                },
            "possibleMalware" to
                (
                    packageName !=
                        context.packageName &&
                    !systemApp &&
                    cappedScore >= 6
                    ),
            "analysisType" to
                "local_heuristic",
            "accessibilityService" to
                hasAccessibilityService,
            "notificationListener" to
                hasNotificationListener,
            "deviceAdmin" to
                hasDeviceAdminReceiver,
            "reasons" to reasons,
        )
    }

    private fun clearCache(
        cache: File,
    ): Boolean {
        return try {
            cache.listFiles()
                ?.forEach {
                    it.deleteRecursively()
                }
            true
        } catch (_: Throwable) {
            false
        }
    }

    private fun openRepairSettings(
        activity: Activity,
        target: String,
    ): Boolean {
        val intent =
            when (target) {
                "storage" ->
                    Intent(
                        Settings
                            .ACTION_INTERNAL_STORAGE_SETTINGS,
                    )
                "internet" ->
                    if (
                        Build.VERSION.SDK_INT >=
                        Build.VERSION_CODES.Q
                    ) {
                        Intent(
                            Settings.Panel
                                .ACTION_INTERNET_CONNECTIVITY,
                        )
                    } else {
                        Intent(
                            Settings
                                .ACTION_WIRELESS_SETTINGS,
                        )
                    }
                "bluetooth" ->
                    Intent(
                        Settings
                            .ACTION_BLUETOOTH_SETTINGS,
                    )
                "battery" ->
                    Intent(
                        Settings
                            .ACTION_BATTERY_SAVER_SETTINGS,
                    )
                "apps" ->
                    Intent(
                        Settings
                            .ACTION_APPLICATION_SETTINGS,
                    )
                "security" ->
                    Intent(
                        Settings
                            .ACTION_SECURITY_SETTINGS,
                    )
                "system_update" -> {
                    val updateIntent =
                        Intent(
                            "android.settings.SYSTEM_UPDATE_SETTINGS",
                        )

                    @Suppress("DEPRECATION")
                    val systemHandlers =
                        activity
                            .packageManager
                            .queryIntentActivities(
                                updateIntent,
                                PackageManager
                                    .MATCH_SYSTEM_ONLY,
                            )

                    val bestHandler =
                        systemHandlers
                            .filter {
                                it.priority > 0
                            }
                            .maxByOrNull {
                                it.priority
                            }

                    if (bestHandler != null) {
                        updateIntent.setClassName(
                            bestHandler
                                .activityInfo
                                .packageName,
                            bestHandler
                                .activityInfo
                                .name,
                        )
                        updateIntent
                    } else {
                        Intent(
                            Settings
                                .ACTION_DEVICE_INFO_SETTINGS,
                        )
                    }
                }
                "date_time" ->
                    Intent(
                        Settings
                            .ACTION_DATE_SETTINGS,
                    )
                "display" ->
                    Intent(
                        Settings
                            .ACTION_DISPLAY_SETTINGS,
                    )
                "sound" ->
                    Intent(
                        Settings
                            .ACTION_SOUND_SETTINGS,
                    )
                "accessibility" ->
                    Intent(
                        Settings
                            .ACTION_ACCESSIBILITY_SETTINGS,
                    )
                "memory" ->
                    Intent(
                        Settings
                            .ACTION_APPLICATION_SETTINGS,
                    )
                else ->
                    Intent(
                        Settings.ACTION_SETTINGS,
                    )
            }

        return try {
            activity.startActivity(intent)
            true
        } catch (_: Throwable) {
            false
        }
    }

    private fun openAppDetails(
        activity: Activity,
        packageName: String,
    ): Boolean {
        if (packageName.isBlank()) {
            return false
        }

        return try {
            activity.startActivity(
                Intent(
                    Settings
                        .ACTION_APPLICATION_DETAILS_SETTINGS,
                    Uri.parse(
                        "package:$packageName",
                    ),
                ),
            )
            true
        } catch (_: Throwable) {
            false
        }
    }

    private fun isPackageInstalled(
        context: Context,
        packageName: String,
    ): Boolean {
        if (packageName.isBlank()) {
            return false
        }

        return try {
            if (
                Build.VERSION.SDK_INT >= 33
            ) {
                context.packageManager
                    .getPackageInfo(
                        packageName,
                        PackageManager
                            .PackageInfoFlags
                            .of(0),
                    )
            } else {
                @Suppress("DEPRECATION")
                context.packageManager
                    .getPackageInfo(
                        packageName,
                        0,
                    )
            }
            true
        } catch (_: PackageManager.NameNotFoundException) {
            false
        } catch (_: Throwable) {
            false
        }
    }

    private fun requestUninstall(
        activity: Activity,
        packageName: String,
    ): Boolean {
        if (
            packageName.isBlank() ||
            packageName ==
                activity.packageName
        ) {
            return false
        }

        return try {
            activity.startActivity(
                Intent(
                    Intent.ACTION_DELETE,
                    Uri.parse(
                        "package:$packageName",
                    ),
                ).putExtra(
                    Intent.EXTRA_RETURN_RESULT,
                    true,
                ),
            )
            true
        } catch (_: Throwable) {
            false
        }
    }
}
